rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /newsletterSubscriptions/{subscriptionId} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'consentSource', 'subscribedAt'])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.consentSource == 'landing-page-footer'
        && request.resource.data.subscribedAt == request.time;
      allow read, update, delete: if false;
    }
    match /carts/{cartId} {
      allow read, write: if false;
    }
    match /orders/{orderId} {
      allow read, write: if false;
    }
    match /orders/{orderId}/events/{eventId} {
      allow read, write: if false;
    }
    match /users/{userId}/notes/{noteId} {
      allow read, write: if false;
    }
    match /customizations/{customizationId} {
      allow read, write: if false;
    }
    match /ecoContributions/{contributionId} {
      allow read, write: if false;
    }
    match /treeRecords/{treeId} {
      allow read, write: if false;
    }
    match /rewardVouchers/{voucherId} {
      allow read, write: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
